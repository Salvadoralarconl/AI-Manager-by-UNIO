# Copy to .env, fill in, then: chmod 600 .env
# .env holds secrets. It is never committed, never baked into the image,
# and not included in backups: keep your own safe copy of it.
# Wrap any value containing "$" in single quotes.

# --- Login (the app owns authentication) -----------------------------------
# Preferred: a scrypt hash, created with
#   docker compose run --rm --no-deps web node src/hash-password.js
OWNER_PASSWORD_HASH=
# Or a plain password (only if no hash is set):
OWNER_PASSWORD=
# Cookie signing key. Generate: openssl rand -hex 32
SESSION_SECRET=
# 1 when the dashboard is reached over HTTPS (Tailscale Serve or the proxy).
COOKIE_SECURE=1

# --- Network exposure --------------------------------------------------------
# Where the web container is published on the host. Keep 127.0.0.1 and use
# Tailscale Serve or the proxy in front of it.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Only for the optional Caddy proxy (--profile proxy):
SITE_ADDRESS=
PROXY_BIND=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# --- Behaviour ---------------------------------------------------------------
# 1 = clearly labelled demo data in a separate database (demo.db).
DEMO_MODE=0
# Paid provider calls stay off until you turn this on deliberately.
PAID_EXECUTION_ENABLED=0
RUNNER_TICK_MS=1000
# Simulator speed multiplier. Empty = 1 normally, 0.05 in demo mode (slow enough to watch).
SIM_SPEED=

# --- Providers (empty = not connected; the app still works for planning/simulation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Home AI endpoint, e.g. http://192.168.1.50:11434 for another machine. Inside
# Docker "localhost" is the container itself, so for a model server on this
# same machine use http://host.docker.internal:PORT .
LOCAL_AI_URL=
LOCAL_AI_API_KEY=

# --- Operations --------------------------------------------------------------
APP_VERSION=latest
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
# Used by deploy/backup.sh
BACKUP_DIR=./backups
BACKUP_KEEP=14
